{
  "name": "ottodot-trial-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ottodot take-home: trial class booking with a race-safe last seat",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "test:multiprocess": "tsx scripts/multi-process-race.ts",
    "verify": "npm run setup && npm run typecheck && npm run lint && npm test && npm run test:multiprocess"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.101.2",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "dotenv": "17.4.2",
    "lucide-react": "1.47.0",
    "next": "16.2.9",
    "radix-ui": "1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "4.21.0",
    "superjson": "2.2.6",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.22.4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
